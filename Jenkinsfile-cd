pipeline {
  agent {
    kubernetes {
      defaultContainer 'jnlp'
      yaml '''
apiVersion: v1
kind: Pod
spec:
  restartPolicy: Never
  containers:
    - name: jnlp
      image: afekio/rke2-kaniko-rke2:1.2
      tty: true
      securityContext:
        privileged: true
        runAsUser: 0
      '''
      podRetention never()
      idleMinutes 0
    }
  }
  
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    
    stage('Deploy via Helm') {
      steps {
        withCredentials([file(credentialsId: env.CICD_KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG_FILE')]) {
          sh '''#!/bin/bash
            set -eu
            
            # --- FIX FOR KUBECONFIG LOCALHOST ISSUE ---
            cp "$KUBECONFIG_FILE" /tmp/kubeconfig
            sed -i 's/127.0.0.1:6443/kubernetes.default.svc:443/g' /tmp/kubeconfig
            export KUBECONFIG="/tmp/kubeconfig"
            # ------------------------------------------
            
            # --- FIX FOR HELM DNS/IPv6 ISSUE ---
            echo "$(getent ahostsv4 cloudnative-pg.github.io | awk 'NR==1 {print $1}') cloudnative-pg.github.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 cloudnative-pg.io | awk 'NR==1 {print $1}') cloudnative-pg.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 ghcr.io | awk 'NR==1 {print $1}') ghcr.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 release-assets.githubusercontent.com | awk 'NR==1 {print $1}') release-assets.githubusercontent.com" >> /etc/hosts || true
            # -----------------------------------
            
            ENV_LOWER=$(echo "$ENVIRONMENT" | tr '[:upper:]' '[:lower:]')
            PREFIX="${ENV_LOWER}-${NAMESPACE_NAME}"
            
            # Determine Replicas based on Environment
            REPLICAS=2
            DB_INSTANCES=3
            if [ "$ENVIRONMENT" == "DEV" ]; then
              REPLICAS=1
              DB_INSTANCES=1
            fi
            
            echo "1. Installing CloudNativePG Operator (CRDs)..."
            helm repo add cnpg https://cloudnative-pg.github.io/charts
            helm repo update
            helm upgrade --install cnpg cnpg/cloudnative-pg --namespace cnpg-system --create-namespace --wait
            
            echo "2. Preparing Namespaces for Secrets..."
            # Create namespaces explicitly before Helm so we can copy secrets into them
            kubectl create namespace ${PREFIX}-auth --dry-run=client -o yaml | kubectl apply -f -
            kubectl create namespace ${PREFIX}-backend --dry-run=client -o yaml | kubectl apply -f -
            kubectl create namespace ${PREFIX}-postgres --dry-run=client -o yaml | kubectl apply -f -
            
            echo "3. Copying Secrets to new dynamic namespaces..."
            # Strip cluster-specific metadata (uid, resourceVersion, creationTimestamp) to avoid conflict errors
            kubectl get secret app-auth-secrets -n dev-auth -o yaml | grep -v -e 'uid:' -e 'resourceVersion:' -e 'creationTimestamp:' | sed "s/namespace: dev-auth/namespace: ${PREFIX}-auth/g" | kubectl apply -f - || echo "Warning: Base auth secret not found"
            kubectl get secret app-backend-secrets -n dev-backend -o yaml | grep -v -e 'uid:' -e 'resourceVersion:' -e 'creationTimestamp:' | sed "s/namespace: dev-backend/namespace: ${PREFIX}-backend/g" | kubectl apply -f - || echo "Warning: Base backend secret not found"
            kubectl get secret app-database-credentials -n dev-postgres -o yaml | grep -v -e 'uid:' -e 'resourceVersion:' -e 'creationTimestamp:' | sed "s/namespace: dev-postgres/namespace: ${PREFIX}-postgres/g" | kubectl apply -f - || echo "Warning: Base DB credentials not found"
            kubectl get secret app-postgres-superuser -n dev-postgres -o yaml | grep -v -e 'uid:' -e 'resourceVersion:' -e 'creationTimestamp:' | sed "s/namespace: dev-postgres/namespace: ${PREFIX}-postgres/g" | kubectl apply -f - || echo "Warning: Base DB superuser secret not found"
            
            echo "4. Deploying Application via Helm Chart..."
            # Run Helm from the root workspace directory
            helm upgrade --install ${PREFIX}-app ./deploy/chart \
              --set environment=${ENV_LOWER} \
              --set namespacePrefix=${PREFIX} \
              --set image.registry=${REGISTRY} \
              --set image.namespace=${IMAGE_NAMESPACE} \
              --set image.tag=${IMAGE_TAG} \
              --set replicas=${REPLICAS} \
              --set dbInstances=${DB_INSTANCES} \
              --set ingress.host=${PREFIX}.local
              
            echo "---------------------------------------------------------"
            echo "Deployment triggered successfully for $ENVIRONMENT!"
            echo "Namespace base name used: $PREFIX"
            echo "You can access the frontend locally via: http://${PREFIX}.local"
            echo "Note: Make sure to map ${PREFIX}.local in your local /etc/hosts to your LoadBalancer IP."
            echo "---------------------------------------------------------"
          '''
        }
      }
    }
  }
}