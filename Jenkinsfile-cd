pipeline {
  agent {
    kubernetes {
      defaultContainer 'jnlp'
      yaml '''
apiVersion: v1
kind: Pod
spec:
  restartPolicy: Never
  containers:
    - name: jnlp
      image: afekio/rke2-kaniko-rke2:1.2
      tty: true
      securityContext:
        privileged: true
        runAsUser: 0
      '''
      podRetention never()
      idleMinutes 0
    }
  }
  
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    
    stage('Deploy via Helm') {
      steps {
        withCredentials([file(credentialsId: env.CICD_KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG_FILE')]) {
          sh '''#!/bin/bash
            set -eu
            
            # --- FIX FOR KUBECONFIG LOCALHOST ISSUE ---
            cp "$KUBECONFIG_FILE" /tmp/kubeconfig
            sed -i 's/127.0.0.1:6443/kubernetes.default.svc:443/g' /tmp/kubeconfig
            export KUBECONFIG="/tmp/kubeconfig"
            # ------------------------------------------
            
            # --- FIX FOR HELM DNS/IPv6 ISSUE ---
            echo "$(getent ahostsv4 cloudnative-pg.github.io | awk 'NR==1 {print $1}') cloudnative-pg.github.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 cloudnative-pg.io | awk 'NR==1 {print $1}') cloudnative-pg.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 ghcr.io | awk 'NR==1 {print $1}') ghcr.io" >> /etc/hosts || true
            echo "$(getent ahostsv4 release-assets.githubusercontent.com | awk 'NR==1 {print $1}') release-assets.githubusercontent.com" >> /etc/hosts || true
            echo "$(getent ahostsv4 github.com | awk 'NR==1 {print $1}') github.com" >> /etc/hosts || true
            echo "$(getent ahostsv4 objects.githubusercontent.com | awk 'NR==1 {print $1}') objects.githubusercontent.com" >> /etc/hosts || true
            # -----------------------------------
            # -----------------------------------
            
            ENV_LOWER=$(echo "$ENVIRONMENT" | tr '[:upper:]' '[:lower:]')
            SAFE_TAG=$(echo "$IMAGE_TAG" | tr '.' '-')
            
            # Namespace Logic - Totally dynamic for DEV
            if [ "$ENVIRONMENT" == "DEV" ]; then
              PREFIX="${ENV_LOWER}-${NAMESPACE_NAME}-${SAFE_TAG}"
            else
              PREFIX="${ENV_LOWER}-${NAMESPACE_NAME}"
            fi
            
            REPLICAS=2
            DB_INSTANCES=3
            if [ "$ENVIRONMENT" == "DEV" ]; then
              REPLICAS=1
              DB_INSTANCES=1
            fi
            
            echo "1. Installing CloudNativePG Operator (CRDs)..."
            helm repo add cnpg https://cloudnative-pg.github.io/charts
            helm repo update
            helm upgrade --install cnpg cnpg/cloudnative-pg --namespace cnpg-system --create-namespace --wait
            
            echo "2. Preparing Namespaces for Environment..."
            kubectl create namespace ${PREFIX}-frontend --dry-run=client -o yaml | kubectl apply -f -
            kubectl create namespace ${PREFIX}-auth --dry-run=client -o yaml | kubectl apply -f -
            kubectl create namespace ${PREFIX}-backend --dry-run=client -o yaml | kubectl apply -f -
            kubectl create namespace ${PREFIX}-postgres --dry-run=client -o yaml | kubectl apply -f -
            
            echo "3. Fetching central secrets from 'app-secret' vault..."
            SECRET_KEY=$(kubectl get secret base-app-secrets -n app-secret -o jsonpath='{.data.SECRET_KEY}' | base64 -d)
            INTERNAL_AUTH_SECRET=$(kubectl get secret base-app-secrets -n app-secret -o jsonpath='{.data.INTERNAL_AUTH_SECRET}' | base64 -d)
            DB_PASS=$(kubectl get secret base-app-secrets -n app-secret -o jsonpath='{.data.db_password}' | base64 -d)
            DB_SUPER=$(kubectl get secret base-app-secrets -n app-secret -o jsonpath='{.data.db_superuser_password}' | base64 -d)
            
            # Construct the dynamic DB URL for this specific environment
            DB_URL="postgresql://app_user:${DB_PASS}@${PREFIX}-postgres-rw.${PREFIX}-postgres.svc.cluster.local:5432/appdb"
            
            echo "4. Injecting secrets into environment namespaces..."
            # Using --dry-run=client -o yaml | kubectl apply -f - ensures clean creation or safe updates without leaving standalone temp files
            kubectl create secret generic app-auth-secrets -n ${PREFIX}-auth \
              --from-literal=SECRET_KEY="$SECRET_KEY" \
              --from-literal=INTERNAL_AUTH_SECRET="$INTERNAL_AUTH_SECRET" \
              --from-literal=DATABASE_URL="$DB_URL" \
              --dry-run=client -o yaml | kubectl apply -f -
              
            kubectl create secret generic app-backend-secrets -n ${PREFIX}-backend \
              --from-literal=SECRET_KEY="$SECRET_KEY" \
              --from-literal=INTERNAL_AUTH_SECRET="$INTERNAL_AUTH_SECRET" \
              --dry-run=client -o yaml | kubectl apply -f -
              
            kubectl create secret generic app-database-credentials -n ${PREFIX}-postgres \
              --from-literal=username="app_user" \
              --from-literal=password="$DB_PASS" \
              --dry-run=client -o yaml | kubectl apply -f -
              
            kubectl create secret generic app-postgres-superuser -n ${PREFIX}-postgres \
              --from-literal=username="postgres" \
              --from-literal=password="$DB_SUPER" \
              --dry-run=client -o yaml | kubectl apply -f -
            
            echo "5. Deploying Application via Helm Chart..."
            helm upgrade --install ${PREFIX}-app ./deploy/chart \
              --set environment=${ENV_LOWER} \
              --set namespacePrefix=${PREFIX} \
              --set image.registry=${REGISTRY} \
              --set image.namespace=${IMAGE_NAMESPACE} \
              --set image.tag=${IMAGE_TAG} \
              --set replicas=${REPLICAS} \
              --set dbInstances=${DB_INSTANCES} \
              --set ingress.host=${PREFIX}.local
              
            echo "---------------------------------------------------------"
            echo "Deployment triggered successfully for $ENVIRONMENT!"
            echo "Environment is completely isolated as: $PREFIX"
            echo "You can access the frontend locally via: http://${PREFIX}.local"
            echo "Note: Make sure to map ${PREFIX}.local in your local /etc/hosts to your LoadBalancer IP."
            echo "---------------------------------------------------------"
          '''
        }
      }
    }
  }
}