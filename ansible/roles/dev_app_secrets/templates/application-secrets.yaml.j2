apiVersion: v1
kind: Secret
metadata:
  name: app-auth-secrets
  namespace: dev-backend
type: Opaque
stringData:
  SECRET_KEY: {{ vault_dev_jwt_secret | quote }}
  INTERNAL_AUTH_SECRET: {{ vault_dev_internal_auth_secret | quote }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-backend-secrets
  namespace: dev-backend
type: Opaque
stringData:
  SECRET_KEY: {{ vault_dev_jwt_secret | quote }}
  INTERNAL_AUTH_SECRET: {{ vault_dev_internal_auth_secret | quote }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-database-secrets
  namespace: dev-backend
type: Opaque
stringData:
  DATABASE_URL: {{ ('postgresql://app_user:' ~ vault_dev_database_password ~ '@dev-postgres-rw.dev-postgres.svc.cluster.local:5432/appdb') | quote }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-database-credentials
  namespace: dev-postgres
type: kubernetes.io/basic-auth
stringData:
  username: app_user
  password: {{ vault_dev_database_password | quote }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-postgres-superuser
  namespace: dev-postgres
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: {{ vault_dev_postgres_superuser_password | quote }}